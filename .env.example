# ============================================================
# AI Interview Trainer Agent — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# NEVER commit the .env file to version control.

# ── IBM watsonx.ai Credentials ──────────────────────────────
# Your IBM Cloud API key (from IBM Cloud → Manage → Access → API keys)
WATSONX_API_KEY=your_watsonx_API_key_here

# Your watsonx.ai project ID (from watsonx.ai → Manage → Projects)
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# watsonx.ai service URL (region-specific — Dallas is default)
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── IBM Granite Model ────────────────────────────────────────
# Model ID to use for generation. Options available on Cloud Lite:
#   ibm/granite-13b-chat-v2
#   ibm/granite-3-8b-instruct
GRANITE_MODEL_ID=ibm/granite-3-8b-instruct

# ── Embeddings ───────────────────────────────────────────────
# Sentence-transformers model used for local embedding generation.
# This runs locally and does NOT consume IBM Cloud quota.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Vector Store ─────────────────────────────────────────────
# Directory where ChromaDB persists its data.
# Created automatically on first run of rag/ingest.py
CHROMA_PERSIST_DIR=chroma_db

# ── Retrieval Settings ───────────────────────────────────────
# Number of top-K documents to retrieve from the vector store per query.
TOP_K_RETRIEVAL=5
